generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = "file:/data/dev.db"
}

model HealthMetric {
  id               String   @id @default(uuid())
  date             DateTime @unique
  steps            Int?
  caloriesBurned   Int?
  sleepHours       Float?
  restingHeartRate Float?
  cardioSessions   Int      @default(0)
  cardioMinutes    Int      @default(0)
  cardioHeartRateAvg Float?
  strengthSessions Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model WeightLog {
  id        String   @id @default(uuid())
  date      DateTime @unique
  weightLbs Float
  createdAt DateTime @default(now())
}

model BodyMeasurement {
  id        String   @id @default(uuid())
  date      DateTime @unique
  chest     Float?
  waist     Float?
  biceps    Float?
  createdAt DateTime @default(now())
}

model Goal {
  id           String   @id @default(uuid())
  metricName   String   @unique // e.g. "Weight", "Chest", "Waist", "Biceps", "StrengthSessions"
  targetValue  Float
  startValue   Float?
  updatedAt    DateTime @updatedAt
}

model Settings {
  id                   String   @id @default("global")
  setupComplete        Boolean  @default(false)
  withingsClientId     String?
  withingsClientSecret String?
  withingsRefreshToken String?
  withingsAccessToken  String?
  withingsTokenExpiresAt Int?
  withingsRedirectUri  String?
  allowManualWeight    Boolean  @default(true)
  lastAppleSyncAt      DateTime?
  lastAppleSyncStatus  String?
}

model Workout {
  id           String   @id @default(uuid())
  externalId   String?  @unique
  date         DateTime
  startTime    DateTime?
  name         String
  type         String   // "cardio" or "strength"
  durationMins Float?
  calories     Float?
  avgHeartRate Float?
  createdAt    DateTime @default(now())

  @@index([date])
}
